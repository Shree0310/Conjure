# Anthropic API key for Claude AI (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Vercel access token (https://vercel.com/account/settings/tokens)
VERCEL_TOKEN=

# Vercel team ID (Team Settings → General, starts with team_)
